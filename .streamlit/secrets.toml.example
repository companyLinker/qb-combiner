# Copy this file to secrets.toml and set a real password.
# secrets.toml is gitignored — keep it out of source control.

APP_PASSWORD = "change-this-to-a-strong-password"

# MongoDB connection (for profile + mapping persistence).
# When running via docker compose, the default below "just works" — the app reaches
# the mongo container at hostname `mongo`. Override only if you use an external Mongo.
MONGODB_URI = "mongodb://mongo:27017"
MONGODB_DB  = "qb_combiner"
